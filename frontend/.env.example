# Copy to .env.local to override. Only NEXT_PUBLIC_* values reach the browser; never put secrets here.

# Where THIS Next.js server forwards /api/* (server-side only; the browser talks to the dashboard's own origin, so
# the session cookie stays first-party).
HMAP_API_ORIGIN=http://127.0.0.1:8000

# Live updates (WebSocket) connect to the API directly. Default: the page's host on port 8000.
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Optional: send REST calls straight to the API instead of through the proxy (that API must then allow this
# site's origin; cookies become cross-site). Leave unset for the normal set-up.
# NEXT_PUBLIC_API_URL=
