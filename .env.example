# hmap configuration — copy to .env (repo root) and adjust: `cp .env.example .env`. The backend reads .env
# automatically; real environment variables override it. Never put real secrets in THIS file (.env is git-ignored).

# --- runtime ---
HMAP_ENV=dev                          # dev | demo
HMAP_LOG_LEVEL=INFO
HMAP_LOG_JSON=true

# --- message bus ---
HMAP_BUS=memory                       # memory (tests) | rabbitmq (demo: needs `make infra-up`)
HMAP_RABBITMQ_URL=amqp://hmap:hmap@127.0.0.1:5672/

# --- state / artifacts ---
HMAP_STORE=memory                     # memory (tests) | postgres (demo: needs `make infra-up`)
HMAP_DATABASE_URL=postgresql+psycopg://hmap:hmap@127.0.0.1:5433/hmap
HMAP_ARTIFACT_ROOT=./data/artifacts

# --- plug-ins ---
HMAP_PLUGINS=all                      # all | comma-separated plug-in names
HMAP_PLAN_MAX_PARALLEL=4              # plan steps of one project that may run at the same time (Sprint 3)
HMAP_STUB_DELAY_S=0                   # demos: minimum seconds a placeholder (stub) step takes

# --- LLM gateway (doc 02) ---
HMAP_LLM_MODE=replay                  # live | record | replay | fake
HMAP_LLM_CACHE_DIR=./samples/llm_cache
# replay mode only: plug-ins whose MISSING answers are fetched live and recorded (e.g. refine); others stay replay
HMAP_LLM_RECORD_MISSING=
# Logical role -> installed model. Default chosen by the model bake-off (docs/members/11/model-choice.md).
HMAP_ROLE_MAP=reasoner=qwen3.5:9b,judge=qwen3.5:9b,coder=qwen3.5:9b,fast=qwen3.5:9b,classify=qwen3.5:9b,embed=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
HMAP_LLM_MAX_CONCURRENCY=1
HMAP_OLLAMA_NUM_CTX=8192              # context window per local call (Ollama's own default, 4096, cuts long prompts)

# --- team cloud key pool (runtime only; doc 02 §2.5) -----------------------------------
# Real keys go ONLY in your local .env (git-ignored). Leave them empty to run everything locally.
# With keys, every chat role tries the cloud first and falls back to the local model (embed always stays local).
# Keys are used only in live/record mode, never in tests or replay.
HMAP_GROQ_API_KEYS=                   # comma-separated, one per contributing teammate
HMAP_GEMINI_API_KEYS=                 # comma-separated
HMAP_GROQ_BASE_URL=https://api.groq.com/openai/v1
HMAP_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# role -> ordered provider:model list (left to right, then the local model). Empty = the built-in default
# (backend/src/hmap/core/config.py DEFAULT_CLOUD_ROLE_MAP, checked 2026-10-12):
#   reasoner=gemini:gemini-3.6-flash|groq:openai/gpt-oss-120b|gemini:gemini-3.5-flash
#   coder=groq:openai/gpt-oss-120b|gemini:gemini-3.6-flash|gemini:gemini-3.5-flash
#   judge=groq:qwen/qwen3.8-27b|gemini:gemini-3.5-flash
#   fast=groq:openai/gpt-oss-20b|gemini:gemini-3.5-flash-lite       classify=(same as fast)
# `none` = keep the keys but use no cloud role; or list only the roles you want, e.g. coder=groq:openai/gpt-oss-120b
HMAP_CLOUD_ROLE_MAP=
HMAP_CLOUD_OK=true                    # false = never call the cloud, even with keys present
# One extra OpenAI-compatible endpoint (older single-key setup; the team pool above is preferred):
# HMAP_CLOUD_BASE_URL=
# HMAP_CLOUD_API_KEY=

# --- accounts (sign-in, sessions, password reset) -------------------------------------
# Where people open the dashboard; used in password-reset links.
HMAP_PUBLIC_URL=http://localhost:3000
# true whenever the dashboard is served over HTTPS (adds the Secure flag to cookies).
HMAP_COOKIE_SECURE=false
HMAP_SESSION_DAYS=14
HMAP_ALLOW_REGISTRATION=true
# Password-reset email. Without HMAP_SMTP_HOST, messages are written to data/dev_mailbox/ (local demo only).
HMAP_SMTP_HOST=
HMAP_SMTP_PORT=587
HMAP_SMTP_USERNAME=
HMAP_SMTP_PASSWORD=
HMAP_SMTP_FROM=HMAP <no-reply@localhost>
HMAP_SMTP_STARTTLS=true

# --- refinement + observability (Sprint 4, Member 4) ------------------------------------
HMAP_REFINE_DEFAULT=false             # new projects "check and improve results" (slower: ~2 model calls per round)
# Traces: set to the OTLP/HTTP endpoint of Jaeger (make obs-up) to send them; empty = no tracing.
HMAP_OTEL_ENDPOINT=                   # e.g. http://127.0.0.1:4318
HMAP_METRICS_PORT=9464                # /metrics of the separate agents process (hmap-agents run); 0 = off
HMAP_METRICS_INTERVAL_S=5             # how often queue / task / agent / RAM gauges are refreshed
HMAP_GRAFANA_PASSWORD=                # Grafana admin password (viewers need none); make obs-up generates one if empty
HMAP_JAEGER_URL=http://127.0.0.1:16686
HMAP_GRAFANA_URL=http://127.0.0.1:3001
HMAP_PROMETHEUS_URL=http://127.0.0.1:9090

# --- autonomous research (Sprint 5, Member 5) ---------------------------------------------
# cached = never touches the network: search results + pages come from data/research_cache and the offline corpus
# (samples/research/corpus). online = live web search + fetch (questions from your documents go to the search
# engines). local = only the local corpus (samples/research/corpus + the project's own uploads).
HMAP_RESEARCH_MODE=cached
HMAP_RESEARCH_PROVIDERS=wikipedia,arxiv,ddg,local
HMAP_RESEARCH_CACHE_DIR=              # default data/research_cache (git-ignored)
HMAP_RESEARCH_MAX_FETCH_MB=5
HMAP_RESEARCH_RATE_PER_HOST=1         # polite crawling: requests per second per host

# --- research verification + security (Sprint 6, Member 6) --------------------------------
HMAP_VERIFY_MAX_ROUNDS=1              # follow-up research rounds after flagged claims (0 = never; the API caps at 3)
HMAP_VERIFY_INDEPENDENT=true          # L3/L4: the verifier's own searches + cross-source conflicts
HMAP_VERIFY_CACHE_DIR=                # default data/verify_cache (git-ignored): the verifier's own search results
# Agent signing keys, newest first, "kid:secret,kid:secret". Empty = the local dev keyring
# data/security/agent_keys.json (created on first use, mode 0600). Rotate: python -m hmap.core.policy rotate
HMAP_AGENT_SECRETS=
HMAP_AGENT_TOKEN_TTL_S=604800         # agent service token lifetime (renewed automatically at half-life)
HMAP_SECURITY_ENFORCE=true            # false = refused messages are only audited, not dropped
HMAP_API_WRITE_RATE=20                # API write requests per second per client (burst HMAP_API_WRITE_BURST)
HMAP_API_WRITE_BURST=200

# --- autonomous coding (Sprint 7, Member 7) ----------------------------------------------------
HMAP_CODING_WORK_DIR=                 # per-task workspaces; default <tmp>/hmap-coding (never inside this folder)
HMAP_CODING_KEEP_WORK=false           # keep workspaces after packaging (debugging)
HMAP_CODING_PYTHON=                   # interpreter for model-written code; default data/coding/venv (make coding-venv)
                                      # if built, else the base Python 3.11 (never the backend venv: no hmap, no .env)
HMAP_CODING_SANDBOX=auto              # auto = macOS sandbox-exec (no network, no project folder); off = plain runner
HMAP_CODING_PROMPT_TOKENS=5500        # prompt budget per model call (fits the local 8k window with the answer)
HMAP_CODING_MAX_STEPS=12              # model calls per coding task
HMAP_CODING_MAX_DEBUG_ROUNDS=4        # edit -> check rounds after a failing check
HMAP_CODING_MAX_REVISIONS=3           # code.revise rounds per original task
HMAP_CODING_CMD_TIMEOUT_S=20          # time limit per workspace command (max 60)

# --- automated testing & execution (Sprint 8, Member 8) ----------------------------------------
HMAP_TESTING_SANDBOX=auto             # auto = Docker (make sandbox-image) when it answers, else the local jailed runner
HMAP_TESTING_IMAGE=hmap-sandbox-py:1  # the sandbox image; built once with the internet, every run is offline
HMAP_TESTING_MEMORY_MB=256            # memory per sandbox run (no swap)
HMAP_TESTING_STAGE_TIMEOUT_S=60       # time limit per stage (the container is killed)
HMAP_TESTING_CONCURRENCY=1            # sandbox runs at the same time (16 GB laptop: keep 1)
HMAP_TESTING_AUTO_REVISE=true         # failed tests -> code.revise -> test again
HMAP_TESTING_MAX_ROUNDS=2             # test -> revise rounds per coding step
HMAP_TESTING_GENERATE=true            # write tests from the acceptance criteria when the code has none
HMAP_TESTING_MUTATION=false           # mutation testing after green unit tests (a step can ask with inputs.mutation)
HMAP_TESTING_MUTANTS=20               # mutants per run
HMAP_TESTING_FUZZ=false               # fuzz text/bytes parsing functions with Hypothesis (Docker; or inputs.fuzz)
HMAP_TESTING_DEP_AUDIT=auto           # known-vulnerable pinned dependencies via OSV; offline = cached answers; off
HMAP_TESTING_RUNTIME=                 # docker --runtime for the sandbox, e.g. runsc (gVisor) when installed
HMAP_TESTING_IMAGE_NODE=hmap-sandbox-node:1   # sandbox image for JS/TS projects (make sandbox-image)

# --- technical documentation + laptop demo (Sprint 9, Member 9) ---------------------------------
HMAP_DOCGEN_SUMMARY_LIMIT=60          # public functions / classes the model summarises per run (docstrings are free)
HMAP_DOCGEN_MAX_ROUNDS=2              # grounding check -> fix rounds; sentences still ungrounded are then removed
HMAP_DOCGEN_RUN_EXAMPLES=true         # run documented Python snippets / commands in the testing sandbox (no network)
HMAP_DOCGEN_AUTO_UPDATE=true          # after a coding step, refresh existing docs (docs.update) when none are pending

# --- final review & recovery (Sprint 10, Member 10) ---
HMAP_REVIEW_MAX_ROUNDS=2              # review -> targeted revision -> re-review rounds before a person is asked
HMAP_REVIEW_JUDGE_SAMPLES=3           # judge votes per requirement the checks cannot decide (evidence order alternates)
HMAP_REVIEW_BUDGET_CALLS=40           # judge model calls per review; the rest stay "not judged" (PARTIAL)
HMAP_REVIEW_AUTO_RECOVER=true         # REVISE creates the revision tasks automatically (false: wait for a person)
HMAP_REVIEW_MIN_CONFIDENCE=0.6        # below this attribution confidence the review escalates instead of guessing
HMAP_REVIEW_HOLD_ON_ESCALATE=true     # ESCALATE keeps the project in REVIEWING until a person decides

# --- local models & routing (Sprint 11, Member 11) ---
HMAP_ROUTER=on                        # on: the model router orders each call's routes (and logs why); off: the role maps, as before Sprint 11
HMAP_ROUTE_OVERRIDES=                 # per task: plugin:role=model or plugin:role=provider:model (* = any plug-in), comma-separated
HMAP_ROUTE_LOG_DAYS=7                 # days a route decision (role, plug-in, model, reason; never the prompt) is kept
HMAP_MODEL_TIER=1                     # local models on this laptop: 0 (replay only) | lite | 1 | 2 (scripts/pull_models.sh)
HMAP_WARMUP=true                      # make demo preloads the local model + embedder so the first step is not a cold load
HMAP_MODELS_ALLOW_PULL=false          # the Models tab may start "ollama pull" for a tier model (false: it shows the command)
# HMAP_MLX_BASE_URL=http://127.0.0.1:8080/v1      # mlx_lm.server (e.g. the LoRA adapter, docs/members/11/eval.md §5)
# HMAP_LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1 # llama.cpp llama-server
# HMAP_MODEL_ROLES=                   # the Sprint 11 spec's name for HMAP_ROLE_MAP (an alias; HMAP_ROLE_MAP wins)
HMAP_DEMO_MIN_FREE_GB=                # make demo pre-flight: free RAM floor in GB (empty = 4 live, 2.5 live with keys, 1.5 replay)
# HMAP_RETRY_DELAYS_S=5,30,120        # Manager backoff per retry in seconds (make demo sets 1,2,5); unset = the default
