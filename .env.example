# hmap configuration — copy to .env (repo root) and adjust: `cp .env.example .env`. The backend reads .env
# automatically; real environment variables override it. Never put real secrets in THIS file (.env is git-ignored).

# --- runtime ---
HMAP_ENV=dev                          # dev | demo
HMAP_LOG_LEVEL=INFO
HMAP_LOG_JSON=true

# --- message bus ---
HMAP_BUS=memory                       # memory (tests) | rabbitmq (demo: needs `make infra-up`)
HMAP_RABBITMQ_URL=amqp://hmap:hmap@127.0.0.1:5672/

# --- state / artifacts ---
HMAP_STORE=memory                     # memory (tests) | postgres (demo: needs `make infra-up`)
HMAP_DATABASE_URL=postgresql+psycopg://hmap:hmap@127.0.0.1:5433/hmap
HMAP_ARTIFACT_ROOT=./data/artifacts

# --- plug-ins ---
HMAP_PLUGINS=all                      # all | comma-separated plug-in names
HMAP_PLAN_MAX_PARALLEL=4              # plan steps of one project that may run at the same time (Sprint 3)
HMAP_STUB_DELAY_S=0                   # demos: minimum seconds a placeholder (stub) step takes

# --- LLM gateway (doc 02) ---
HMAP_LLM_MODE=replay                  # live | record | replay | fake
HMAP_LLM_CACHE_DIR=./samples/llm_cache
# replay mode only: plug-ins whose MISSING answers are fetched live and recorded (e.g. refine); others stay replay
HMAP_LLM_RECORD_MISSING=
# Logical role -> installed model. Default chosen by the model bake-off (docs/members/11/model-choice.md).
HMAP_ROLE_MAP=reasoner=qwen3.5:9b,judge=qwen3.5:9b,coder=qwen3.5:9b,fast=qwen3.5:9b,classify=qwen3.5:9b,embed=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
HMAP_LLM_MAX_CONCURRENCY=1
HMAP_OLLAMA_NUM_CTX=8192              # context window per local call (Ollama's own default, 4096, cuts long prompts)

# --- team cloud key pool (runtime only; doc 02 §2.5) -----------------------------------
# Real keys go ONLY in your local .env (git-ignored). Leave them empty to run everything locally.
# With keys, every chat role tries the cloud first and falls back to the local model (embed always stays local).
# Keys are used only in live/record mode, never in tests or replay.
HMAP_GROQ_API_KEYS=                   # comma-separated, one per contributing teammate
HMAP_GEMINI_API_KEYS=                 # comma-separated
HMAP_GROQ_BASE_URL=https://api.groq.com/openai/v1
HMAP_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# role -> ordered provider:model list (left to right, then the local model). Empty = the built-in default
# (backend/src/hmap/core/config.py DEFAULT_CLOUD_ROLE_MAP, checked 2026-10-12):
#   reasoner=gemini:gemini-3.6-flash|groq:openai/gpt-oss-120b|gemini:gemini-3.5-flash
#   coder=groq:openai/gpt-oss-120b|gemini:gemini-3.6-flash|gemini:gemini-3.5-flash
#   judge=groq:qwen/qwen3.8-27b|gemini:gemini-3.5-flash
#   fast=groq:openai/gpt-oss-20b|gemini:gemini-3.5-flash-lite       classify=(same as fast)
# `none` = keep the keys but use no cloud role; or list only the roles you want, e.g. coder=groq:openai/gpt-oss-120b
HMAP_CLOUD_ROLE_MAP=
HMAP_CLOUD_OK=true                    # false = never call the cloud, even with keys present

# --- accounts (sign-in, sessions, password reset) -------------------------------------
# Where people open the dashboard; used in password-reset links.
HMAP_PUBLIC_URL=http://localhost:3000
# true whenever the dashboard is served over HTTPS (adds the Secure flag to cookies).
HMAP_COOKIE_SECURE=false
HMAP_SESSION_DAYS=14
HMAP_ALLOW_REGISTRATION=true
# Password-reset email. Without HMAP_SMTP_HOST, messages are written to data/dev_mailbox/ (local demo only).
HMAP_SMTP_HOST=
HMAP_SMTP_PORT=587
HMAP_SMTP_USERNAME=
HMAP_SMTP_PASSWORD=
HMAP_SMTP_FROM=HMAP <no-reply@localhost>
HMAP_SMTP_STARTTLS=true

# --- refinement + observability (Sprint 4, Member 4) ------------------------------------
HMAP_REFINE_DEFAULT=false             # new projects "check and improve results" (slower: ~2 model calls per round)
# Traces: set to the OTLP/HTTP endpoint of Jaeger (make obs-up) to send them; empty = no tracing.
HMAP_OTEL_ENDPOINT=                   # e.g. http://127.0.0.1:4318
HMAP_METRICS_PORT=9464                # /metrics of the separate agents process (hmap-agents run); 0 = off
HMAP_METRICS_INTERVAL_S=5             # how often queue / task / agent / RAM gauges are refreshed
HMAP_GRAFANA_PASSWORD=                # Grafana admin password (viewers need none); make obs-up generates one if empty
HMAP_JAEGER_URL=http://127.0.0.1:16686
HMAP_GRAFANA_URL=http://127.0.0.1:3001
HMAP_PROMETHEUS_URL=http://127.0.0.1:9090
