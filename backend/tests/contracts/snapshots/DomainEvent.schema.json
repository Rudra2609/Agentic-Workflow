{
  "$id": "hmap:DomainEvent:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "aggregate_id": {
      "description": "task_id, project_id or agent_id the event is about",
      "minLength": 1,
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_version": {
      "default": 0,
      "description": "state_version after the change (ordering, \u00a712)",
      "minimum": 0,
      "title": "Aggregate Version",
      "type": "integer"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "traceparent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceparent"
    }
  },
  "required": [
    "event_type",
    "aggregate_id"
  ],
  "title": "DomainEvent",
  "type": "object",
  "x-schema-version": "1.0"
}
