{
  "$defs": {
    "ArtifactRef": {
      "description": "Immutable, content-addressed artifact reference (research \u00a715). A correction is a new version.",
      "properties": {
        "access_scope": {
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "previous version this one replaces",
          "title": "Supersedes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "version",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_by",
        "created_at",
        "access_scope"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "StageResult": {
      "properties": {
        "duration_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "StageResult",
      "type": "object"
    },
    "TestFailure": {
      "properties": {
        "category": {
          "enum": [
            "SYNTAX",
            "IMPORT",
            "ASSERTION",
            "TIMEOUT",
            "CRASH",
            "SECURITY",
            "LINT",
            "ENV"
          ],
          "title": "Category",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "TestFailure",
      "type": "object"
    }
  },
  "$id": "hmap:TestReport:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changeset_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coverage": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage"
    },
    "exec_log_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/TestFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "stages": {
      "additionalProperties": {
        "$ref": "#/$defs/StageResult"
      },
      "propertyNames": {
        "enum": [
          "static",
          "build",
          "unit",
          "integration",
          "security",
          "execution"
        ]
      },
      "title": "Stages",
      "type": "object"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "stages",
    "passed"
  ],
  "title": "TestReport",
  "type": "object",
  "x-schema-version": "1.0"
}
