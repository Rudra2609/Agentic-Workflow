{
  "$defs": {
    "ArtifactRef": {
      "description": "Immutable, content-addressed artifact reference (research \u00a715). A correction is a new version.",
      "properties": {
        "access_scope": {
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "previous version this one replaces",
          "title": "Supersedes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "version",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_by",
        "created_at",
        "access_scope"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ClaimVerdict": {
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "contradicting": {
          "items": {
            "type": "string"
          },
          "title": "Contradicting",
          "type": "array"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "supporting": {
          "description": "evidence ids or URLs",
          "items": {
            "type": "string"
          },
          "title": "Supporting",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "VERIFIED",
            "UNSUPPORTED",
            "CONFLICTING",
            "NEEDS_MORE_RESEARCH"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "verdict",
        "confidence"
      ],
      "title": "ClaimVerdict",
      "type": "object"
    }
  },
  "$id": "hmap:VerificationReport:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "claim_verdicts": {
      "items": {
        "$ref": "#/$defs/ClaimVerdict"
      },
      "title": "Claim Verdicts",
      "type": "array"
    },
    "follow_up_questions": {
      "items": {
        "type": "string"
      },
      "title": "Follow Up Questions",
      "type": "array"
    },
    "research_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "readOnly": true,
      "title": "Summary",
      "type": "object"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "claim_verdicts",
    "summary"
  ],
  "title": "VerificationReport",
  "type": "object",
  "x-schema-version": "1.0"
}
