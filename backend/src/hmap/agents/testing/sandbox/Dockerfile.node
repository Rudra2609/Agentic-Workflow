# Sandbox image for JavaScript / TypeScript projects (Sprint 8 stretch: per-language images). Built once, with the
# internet (make sandbox-image). Same run limits as the Python image (sandbox/docker.py); stages.py needs python3.
FROM node:22.12.0-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin sandbox
WORKDIR /opt/hmap
RUN npm init -y >/dev/null && npm install --no-audit --no-fund eslint@9.17.0 @eslint/js@9.17.0 globals@15.14.0 \
      typescript@5.7.2 @types/node@22.10.2 && npm cache clean --force
COPY stages.py /opt/hmap/stages.py
COPY eslint.config.mjs /opt/hmap/eslint.config.mjs
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp NODE_ENV=test
USER 10001
WORKDIR /work
LABEL hmap.sandbox.image="node-1"
