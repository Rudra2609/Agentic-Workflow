{
  "$defs": {
    "Milestone": {
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Task Ids",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Milestone",
      "type": "object"
    },
    "Phase": {
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the enclosing phase / group (plan hierarchy, Sprint 3); tasks stay executable leaves, groups are never run",
          "title": "Parent Id"
        },
        "task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Task Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Phase",
      "type": "object"
    },
    "PlanTask": {
      "properties": {
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "agent_capability": {
          "minLength": 1,
          "title": "Agent Capability",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "est_effort": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "hours",
          "title": "Est Effort"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "phase": {
          "default": "implement",
          "enum": [
            "research",
            "design",
            "implement",
            "test",
            "document",
            "review"
          ],
          "title": "Phase",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "normal"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "research_questions": {
          "description": "seed for a ResearchBrief (M5)",
          "items": {
            "type": "string"
          },
          "title": "Research Questions",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "agent_capability"
      ],
      "title": "PlanTask",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Roadmap": {
      "properties": {
        "markdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown"
        },
        "milestones": {
          "items": {
            "$ref": "#/$defs/Milestone"
          },
          "title": "Milestones",
          "type": "array"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "title": "Phases",
          "type": "array"
        }
      },
      "title": "Roadmap",
      "type": "object"
    }
  },
  "$id": "hmap:TaskGraph:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "coverage_matrix": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "requirement id -> task ids",
      "title": "Coverage Matrix",
      "type": "object"
    },
    "edges": {
      "description": "``[{from, to}]`` derived from ``depends_on`` (single source of truth).",
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "readOnly": true,
      "title": "Edges",
      "type": "array"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "roadmap": {
      "$ref": "#/$defs/Roadmap"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/PlanTask"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "tasks",
    "edges"
  ],
  "title": "TaskGraph",
  "type": "object",
  "x-schema-version": "1.0"
}
