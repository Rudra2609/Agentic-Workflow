{
  "$defs": {
    "ArtifactRef": {
      "description": "Immutable, content-addressed artifact reference (research \u00a715). A correction is a new version.",
      "properties": {
        "access_scope": {
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "previous version this one replaces",
          "title": "Supersedes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "version",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_by",
        "created_at",
        "access_scope"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Critique": {
      "properties": {
        "critic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Critic"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score"
      ],
      "title": "Critique",
      "type": "object"
    },
    "Issue": {
      "properties": {
        "category": {
          "enum": [
            "FORMAT",
            "SCHEMA",
            "OMISSION",
            "HALLUCINATION",
            "FACTUAL",
            "LOGIC",
            "REQUIREMENT_VIOLATION",
            "CONSISTENCY",
            "STYLE",
            "SAFETY"
          ],
          "title": "Category",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "fix_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix Hint"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "severity": {
          "enum": [
            "info",
            "minor",
            "major",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "category",
        "severity",
        "description"
      ],
      "title": "Issue",
      "type": "object"
    },
    "RefinementIteration": {
      "properties": {
        "critique": {
          "$ref": "#/$defs/Critique"
        },
        "duration_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "critique",
        "score"
      ],
      "title": "RefinementIteration",
      "type": "object"
    },
    "RefinementSpec": {
      "properties": {
        "critics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Critics",
          "type": "array"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "reviser": {
          "minLength": 1,
          "title": "Reviser",
          "type": "string"
        },
        "stop_policy": {
          "additionalProperties": true,
          "description": "e.g. {'max_iters': 3, 'threshold': 0.9}",
          "title": "Stop Policy",
          "type": "object"
        }
      },
      "required": [
        "producer",
        "critics",
        "reviser"
      ],
      "title": "RefinementSpec",
      "type": "object"
    }
  },
  "$id": "hmap:RefinementTrace:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "best_iteration": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Best Iteration"
    },
    "iterations": {
      "items": {
        "$ref": "#/$defs/RefinementIteration"
      },
      "title": "Iterations",
      "type": "array"
    },
    "spec": {
      "$ref": "#/$defs/RefinementSpec"
    },
    "stop_reason": {
      "enum": [
        "max_iters",
        "threshold",
        "no_critical_issues",
        "plateau",
        "budget",
        "tests_pass",
        "cancelled",
        "error"
      ],
      "title": "Stop Reason",
      "type": "string"
    }
  },
  "required": [
    "spec",
    "stop_reason"
  ],
  "title": "RefinementTrace",
  "type": "object",
  "x-schema-version": "1.0"
}
