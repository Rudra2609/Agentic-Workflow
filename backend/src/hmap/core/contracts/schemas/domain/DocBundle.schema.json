{
  "$defs": {
    "AccuracyReport": {
      "properties": {
        "examples_failed": {
          "default": 0,
          "minimum": 0,
          "title": "Examples Failed",
          "type": "integer"
        },
        "examples_verified": {
          "default": 0,
          "minimum": 0,
          "title": "Examples Verified",
          "type": "integer"
        },
        "grounded_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Grounded Pct",
          "type": "number"
        },
        "ungrounded_claims": {
          "items": {
            "type": "string"
          },
          "title": "Ungrounded Claims",
          "type": "array"
        }
      },
      "required": [
        "grounded_pct"
      ],
      "title": "AccuracyReport",
      "type": "object"
    },
    "ArtifactRef": {
      "description": "Immutable, content-addressed artifact reference (research \u00a715). A correction is a new version.",
      "properties": {
        "access_scope": {
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "previous version this one replaces",
          "title": "Supersedes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "version",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_by",
        "created_at",
        "access_scope"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "hmap:DocBundle:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accuracy_report": {
      "$ref": "#/$defs/AccuracyReport"
    },
    "api_docs_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "architecture_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "readme_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "report_sections_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "summaries_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "accuracy_report"
  ],
  "title": "DocBundle",
  "type": "object",
  "x-schema-version": "1.0"
}
