{
  "$defs": {
    "ArtifactRef": {
      "description": "Immutable, content-addressed artifact reference (research \u00a715). A correction is a new version.",
      "properties": {
        "access_scope": {
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "previous version this one replaces",
          "title": "Supersedes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "version",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_by",
        "created_at",
        "access_scope"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommandRun": {
      "properties": {
        "cmd": {
          "minLength": 1,
          "title": "Cmd",
          "type": "string"
        },
        "duration_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        }
      },
      "required": [
        "cmd",
        "exit_code"
      ],
      "title": "CommandRun",
      "type": "object"
    }
  },
  "$id": "hmap:CodeChangeSet:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "commands_run": {
      "items": {
        "$ref": "#/$defs/CommandRun"
      },
      "title": "Commands Run",
      "type": "array"
    },
    "files_changed": {
      "items": {
        "type": "string"
      },
      "title": "Files Changed",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "patch_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "workspace_ref": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "task_id",
    "workspace_ref"
  ],
  "title": "CodeChangeSet",
  "type": "object",
  "x-schema-version": "1.0"
}
