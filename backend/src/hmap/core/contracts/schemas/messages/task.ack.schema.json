{
  "$id": "hmap:task.ack:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "available_slots": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available Slots"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "execution_id": {
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "execution_id",
    "decision"
  ],
  "title": "task.ack",
  "type": "object",
  "x-schema-version": "1.0"
}
