{
  "$defs": {
    "CapabilityDescriptor": {
      "description": "Research \u00a720: matched by name/version first, then load and health.",
      "properties": {
        "constraints": {
          "additionalProperties": true,
          "description": "e.g. {'max_concurrency': 2}",
          "title": "Constraints",
          "type": "object"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CapabilityDescriptor",
      "type": "object"
    }
  },
  "$id": "hmap:agent.register:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agent_id": {
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "build_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build Version"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDescriptor"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "endpoint": {
      "description": "queue name or URL the agent consumes from",
      "minLength": 1,
      "title": "Endpoint",
      "type": "string"
    },
    "is_stub": {
      "default": false,
      "title": "Is Stub",
      "type": "boolean"
    },
    "max_slots": {
      "default": 1,
      "minimum": 1,
      "title": "Max Slots",
      "type": "integer"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "plugin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plugin"
    },
    "protocol_versions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Protocol Versions",
      "type": "array"
    },
    "token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "per-agent service token (Sprint 6)",
      "title": "Token"
    }
  },
  "required": [
    "agent_id",
    "endpoint",
    "capabilities",
    "protocol_versions"
  ],
  "title": "agent.register",
  "type": "object",
  "x-schema-version": "1.0"
}
