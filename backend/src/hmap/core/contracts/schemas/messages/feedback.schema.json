{
  "$id": "hmap:feedback:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "decision": {
      "enum": [
        "approve",
        "revise",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "findings": {
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity"
    },
    "target_execution_id": {
      "minLength": 1,
      "title": "Target Execution Id",
      "type": "string"
    }
  },
  "required": [
    "target_execution_id",
    "decision"
  ],
  "title": "feedback",
  "type": "object",
  "x-schema-version": "1.0"
}
