{
  "$defs": {
    "ArtifactRef": {
      "description": "Immutable, content-addressed artifact reference (research \u00a715). A correction is a new version.",
      "properties": {
        "access_scope": {
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "previous version this one replaces",
          "title": "Supersedes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "version",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_by",
        "created_at",
        "access_scope"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "hmap:task.progress:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "execution_id": {
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "percent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Percent",
      "type": "integer"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "percent",
    "summary"
  ],
  "title": "task.progress",
  "type": "object",
  "x-schema-version": "1.0"
}
