{
  "$defs": {
    "ArtifactRef": {
      "description": "Immutable, content-addressed artifact reference (research \u00a715). A correction is a new version.",
      "properties": {
        "access_scope": {
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "previous version this one replaces",
          "title": "Supersedes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "version",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_by",
        "created_at",
        "access_scope"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ContextRef": {
      "description": "Pinned immutable context snapshot ``CTX-42@3`` (research \u00a714).",
      "properties": {
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "context_id",
        "version"
      ],
      "title": "ContextRef",
      "type": "object"
    }
  },
  "$id": "hmap:revision.request:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifact_refs": {
      "description": "e.g. TestReport / ReviewReport",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "context_refs": {
      "items": {
        "$ref": "#/$defs/ContextRef"
      },
      "title": "Context Refs",
      "type": "array"
    },
    "new_execution_id": {
      "minLength": 1,
      "title": "New Execution Id",
      "type": "string"
    },
    "required_changes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Changes",
      "type": "array"
    },
    "target_execution_id": {
      "minLength": 1,
      "title": "Target Execution Id",
      "type": "string"
    }
  },
  "required": [
    "new_execution_id",
    "target_execution_id",
    "required_changes"
  ],
  "title": "revision.request",
  "type": "object",
  "x-schema-version": "1.0"
}
