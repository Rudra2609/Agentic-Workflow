{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "AGENT_UNAVAILABLE",
        "NETWORK",
        "TIMEOUT",
        "INVALID_MESSAGE",
        "INVALID_TASK",
        "SCHEMA_UNSUPPORTED",
        "MISSING_CONTEXT",
        "DEPENDENCY",
        "TOOL_TRANSIENT",
        "MODEL_TRANSIENT",
        "AUTHENTICATION",
        "AUTHORIZATION",
        "RESOURCE_EXHAUSTED",
        "ARTIFACT_CONFLICT",
        "ARTIFACT_INTEGRITY",
        "WRONG_RESULT",
        "CANCELLED",
        "INTERNAL_AGENT"
      ],
      "title": "ErrorCode",
      "type": "string"
    }
  },
  "$id": "hmap:error:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "diagnostics_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diagnostics Ref"
    },
    "error_code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "execution_id": {
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    }
  },
  "required": [
    "execution_id",
    "error_code",
    "message",
    "retryable"
  ],
  "title": "error",
  "type": "object",
  "x-schema-version": "1.0"
}
